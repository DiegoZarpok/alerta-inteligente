# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser enviado ao GitHub (já está no .gitignore).

MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/
MONGODB_BANCO=alerta_inteligente
GEMINI_API_KEY=coloque_sua_chave_aqui
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui
LIMIAR_VAZAO_M3S=2430

# Chave de criptografia AES-256 (64 caracteres hexadecimais) e sal do hash dos moradores
ALERTA_CHAVE=coloque_64_caracteres_hexadecimais
ALERTA_SAL=coloque_um_texto_secreto
