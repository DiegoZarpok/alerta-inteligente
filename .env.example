# Modelo do arquivo .env. NÃO preencha este arquivo: rode "python cli.py configurar",
# que cria o .env com senhas e chaves aleatórias. O .env nunca vai para o GitHub (.gitignore).

MONGODB_HOST=localhost:27017
MONGODB_BANCO=alerta_inteligente
MONGODB_ADMIN_USUARIO=admin
MONGODB_ADMIN_SENHA=

# Senhas dos usuários de cada serviço (papéis com privilégio mínimo)
SENHA_SVC_COLETA=
SENHA_SVC_MODELO=
SENHA_SVC_IA=
SENHA_SVC_CLASSIFICADOR=
SENHA_SVC_BOT=
SENHA_SVC_N8N=
SENHA_OPERADOR=
SENHA_AUDITOR=

# Criptografia AES-256 (64 caracteres hexadecimais) e sal do hash dos moradores
ALERTA_CHAVE=
ALERTA_SAL=

# Token exigido pela API local (o n8n e o bot mandam no cabeçalho X-Token)
API_TOKEN=

# Gemini (chave criada em aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
PROMPT_ALERTA_VERSAO=v2

# Telegram (token do @BotFather e id do grupo de alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ALERTAS=

# Operação: "reproducao" roda dias históricos como se fossem hoje; "tempo_real" usa a telemetria da ANA
MODO_OPERACAO=reproducao
REPRODUCAO_INICIO=2007-12-01

# Modelo: tempo de retorno do limiar (estudo da UESC) e ano de corte entre treino e teste
LIMIAR_TR_ALVO=3
ANO_CORTE_TREINO=2000
